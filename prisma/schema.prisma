datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ReviewStatusDb {
  queued
  approved
  rejected
}

enum PaymentStatusDb {
  pending
  paid
}

enum TransbankTransactionStatusDb {
  created
  paid
  rejected
}

enum TransbankRequestTypeDb {
  checkup
  chronic_control
}

enum OrderPdfCategoryDb {
  laboratory
  image
  procedure
  interconsultation
}

enum SymptomsRequestStatusDb {
  draft
  paid
  in_flow
  pending_validation
  validated
  rejected
}

enum MedicalApprovalMethodDb {
  automatic_protocol
  manual
}

enum ClinicalRequestTypeDb {
  checkup
  chronic_control
  symptoms
}

enum DiscountTypeDb {
  percent_off
  fixed_final_amount
}

enum OrderPdfAccessOutcomeDb {
  granted
  expired
  revoked
  not_found
  storage_error
}

enum MedicalPortalRoleDb {
  portal
  doctor
  admin
}

enum OutboxStatusDb {
  pending
  processing
  completed
  failed
}

enum ElectronicReceiptStatusDb {
  pending
  ready
  sent
}

enum MedicalPrescriptionStatusDb {
  signed
  sent
  email_failed
  revoked
}

enum MedicalScheduleBlockTypeDb {
  short_consultation
  follow_up
  intake
  home_visit
  blocked
}

model Healthcheck {
  id        String   @id @default(cuid())
  key       String   @unique
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                     String                       @id @default(cuid())
  name                   String
  email                  String                       @unique
  passwordHash           String
  passwordSalt           String
  profileFirstName       String
  profilePaternalSurname String                       @default("")
  profileMaternalSurname String                       @default("")
  profileRut             String                       @default("")
  profileBirthDate       String                       @default("")
  profileSex             String                       @default("")
  profileEmail           String
  profilePhone           String                       @default("")
  profileAddress         String                       @default("")
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  sessions               Session[]
  checkups               CheckupRequest[]
  chronicControls        ChronicControlRequest[]
  symptomsRequests       SymptomsRequest[]
  medicalPrescriptions   MedicalPrescription[]
  scheduleAppointments   MedicalScheduleAppointment[]
}

model Session {
  token     String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CheckupRequest {
  id                      String                   @id
  userId                  String?
  input                   Json
  patientFirstName        String
  patientPaternalSurname  String                   @default("")
  patientMaternalSurname  String                   @default("")
  patientRut              String                   @default("")
  patientBirthDate        String                   @default("")
  patientEmail            String                   @default("")
  patientPhone            String                   @default("")
  patientAddress          String                   @default("")
  rec                     Json
  reviewStatus            ReviewStatusDb           @default(queued)
  queuedAt                DateTime?
  approvedAt              DateTime?
  approvedByName          String?
  approvedByRut           String?
  approvedBySis           String?
  approvedByEmail         String?
  approvalMethod          MedicalApprovalMethodDb?
  approvalProtocolVersion String?
  rejectedAt              DateTime?
  orderId                 String?
  orderEmailSentAt        DateTime?
  orderEmailMessageId     String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  payment                 CheckupPayment?

  @@index([userId])
}

model ChronicControlRequest {
  id                      String                   @id
  userId                  String?
  conditions              Json
  patientFirstName        String
  patientPaternalSurname  String                   @default("")
  patientMaternalSurname  String                   @default("")
  patientRut              String                   @default("")
  patientBirthDate        String                   @default("")
  patientEmail            String                   @default("")
  patientPhone            String                   @default("")
  patientAddress          String                   @default("")
  yearsSinceDiagnosis     Int
  hasRecentChanges        Boolean
  usesMedication          Boolean
  selectedMedications     Json
  rec                     Json
  reviewStatus            ReviewStatusDb           @default(queued)
  queuedAt                DateTime?
  approvedAt              DateTime?
  approvedByName          String?
  approvedByRut           String?
  approvedBySis           String?
  approvedByEmail         String?
  approvalMethod          MedicalApprovalMethodDb?
  approvalProtocolVersion String?
  rejectedAt              DateTime?
  orderId                 String?
  orderEmailSentAt        DateTime?
  orderEmailMessageId     String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  payment                 ChronicControlPayment?

  @@index([userId])
}

model SymptomsRequest {
  id                     String                       @id
  userId                 String?
  symptomsText           String
  flowId                 String                       @default("")
  oneLinerSummary        String                       @default("")
  primarySymptom         String                       @default("")
  secondarySymptoms      Json
  patientFirstName       String
  patientPaternalSurname String                       @default("")
  patientMaternalSurname String                       @default("")
  patientRut             String                       @default("")
  patientBirthDate       String                       @default("")
  patientSex             String                       @default("")
  patientEmail           String                       @default("")
  patientPhone           String                       @default("")
  patientAddress         String                       @default("")
  antecedents            Json
  interpretation         Json
  followUpQuestions      Json
  followUpAnswers        Json
  clinicalState          Json?
  questionQueue          Json?
  interviewMetadata      Json?
  suggestedTests         Json
  selectedTests          Json
  notes                  Json
  engineVersion          String                       @default("")
  cachedInput            String                       @default("")
  aiConsentAt            DateTime?
  aiConsentVersion       String?
  aiProvider             String?
  reviewStatus           SymptomsRequestStatusDb      @default(draft)
  validatedByEmail       String?
  validatedByUserId      String?
  validatedByName        String?
  validatedByRut         String?
  validatedBySis         String?
  validatedAt            DateTime?
  orderEmailSentAt       DateTime?
  orderEmailMessageId    String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  user                   User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  payment                SymptomsPayment?
  transactions           SymptomsPaymentTransaction[]
  pdfAssets              SymptomsOrderPdfAsset[]

  @@index([userId])
  @@index([reviewStatus, createdAt])
  @@index([validatedByEmail, validatedAt])
}

model ElectronicReceipt {
  id               String                    @id @default(cuid())
  requestType      ClinicalRequestTypeDb
  requestId        String
  paymentId        String
  amount           Int
  currency         String                    @default("CLP")
  serviceLabel     String
  patientName      String
  patientEmail     String
  patientRut       String?
  status           ElectronicReceiptStatusDb @default(pending)
  folio            String?
  fileName         String?
  blobUrl          String?
  blobPath         String?
  sizeBytes        Int?
  issuedAt         DateTime?
  uploadedAt       DateTime?
  uploadedByUserId String?
  emailSentAt      DateTime?
  emailMessageId   String?
  lastEmailError   String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([requestType, requestId])
  @@index([status, createdAt])
  @@index([patientEmail, createdAt])
}

model CheckupPayment {
  requestId  String          @id
  amount     Int
  currency   String
  paymentId  String          @unique
  cardLast4  String
  cardholder String
  status     PaymentStatusDb @default(pending)
  createdAt  DateTime        @default(now())
  paidAt     DateTime?
  updatedAt  DateTime        @updatedAt
  request    CheckupRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model ChronicControlPayment {
  requestId  String                @id
  amount     Int
  currency   String
  paymentId  String                @unique
  cardLast4  String
  cardholder String
  status     PaymentStatusDb       @default(pending)
  createdAt  DateTime              @default(now())
  paidAt     DateTime?
  updatedAt  DateTime              @updatedAt
  request    ChronicControlRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model SymptomsPayment {
  requestId  String          @id
  amount     Int
  currency   String
  paymentId  String          @unique
  cardLast4  String
  cardholder String
  status     PaymentStatusDb @default(pending)
  createdAt  DateTime        @default(now())
  paidAt     DateTime?
  updatedAt  DateTime        @updatedAt
  request    SymptomsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model TransbankPaymentTransaction {
  id                String                       @id @default(cuid())
  orderId           String                       @unique
  sessionId         String
  requestType       TransbankRequestTypeDb
  requestId         String
  amount            Int
  token             String                       @unique
  webpayUrl         String
  status            TransbankTransactionStatusDb @default(created)
  authorizationCode String?
  buyOrder          String?
  responseCode      Int?
  paymentTypeCode   String?
  cardLast4         String?
  transactionDate   DateTime?
  transbankResponse Json?
  errorReason       String?
  committedAt       DateTime?
  paidAt            DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([requestType, requestId])
  @@index([status, createdAt])
}

model SymptomsPaymentTransaction {
  id                String                       @id @default(cuid())
  requestId         String
  orderId           String                       @unique
  sessionId         String
  amount            Int
  token             String                       @unique
  webpayUrl         String
  status            TransbankTransactionStatusDb @default(created)
  authorizationCode String?
  buyOrder          String?
  responseCode      Int?
  paymentTypeCode   String?
  cardLast4         String?
  transactionDate   DateTime?
  transbankResponse Json?
  errorReason       String?
  committedAt       DateTime?
  paidAt            DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  request           SymptomsRequest              @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([status, createdAt])
}

model OrderPdfAsset {
  id          String                 @id @default(cuid())
  requestType TransbankRequestTypeDb
  requestId   String
  category    OrderPdfCategoryDb
  fileName    String
  blobUrl     String
  blobPath    String
  sizeBytes   Int
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([requestType, requestId, category])
  @@index([requestType, requestId])
}

model SymptomsOrderPdfAsset {
  id        String             @id @default(cuid())
  requestId String
  category  OrderPdfCategoryDb
  fileName  String
  blobUrl   String
  blobPath  String
  sizeBytes Int
  signedAt  DateTime           @default(now())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  request   SymptomsRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, category])
  @@index([requestId])
}

model DiscountCode {
  id             String         @id @default(cuid())
  codeHash       String         @unique
  label          String
  type           DiscountTypeDb
  percentOff     Int?
  finalAmountClp Int?
  active         Boolean        @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([active, startsAt, expiresAt])
}

model OrderPdfAccessLink {
  id               String                @id @default(cuid())
  tokenHash        String                @unique
  requestType      ClinicalRequestTypeDb
  requestId        String
  category         OrderPdfCategoryDb
  blobPath         String
  fileName         String
  purpose          String
  recipientKeyHash String?
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime              @default(now())
  lastAccessedAt   DateTime?
  accessLogs       OrderPdfAccessLog[]

  @@index([requestType, requestId])
  @@index([expiresAt, revokedAt])
}

model OrderPdfAccessLog {
  id         String                  @id @default(cuid())
  linkId     String
  outcome    OrderPdfAccessOutcomeDb
  ipHash     String?
  userAgent  String?
  accessedAt DateTime                @default(now())
  link       OrderPdfAccessLink      @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, accessedAt])
  @@index([outcome, accessedAt])
}

model RateLimitBucket {
  keyHash     String
  action      String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@id([keyHash, action, windowStart])
  @@index([expiresAt])
}

model MedicalPortalUser {
  id                  String                    @id @default(cuid())
  email               String                    @unique
  name                String
  firstName           String                    @default("")
  paternalSurname     String                    @default("")
  maternalSurname     String                    @default("")
  specialty           String?
  medicalRut          String?
  sisRegistration     String?
  role                MedicalPortalRoleDb       @default(doctor)
  passwordHash        String
  passwordSalt        String
  active              Boolean                   @default(true)
  mfaEnabled          Boolean                   @default(false)
  totpSecretEncrypted String?
  lastLoginAt         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  sessions            MedicalPortalSession[]
  auditLogs           MedicalAuditLog[]
  invitations         MedicalPortalInvitation[] @relation("MedicalPortalInviter")
  prescriptions       MedicalPrescription[]
  scheduleBlocks      MedicalScheduleBlock[]

  @@index([active, role])
}

model MedicalScheduleBlock {
  id                  String                       @id @default(cuid())
  doctorUserId        String
  type                MedicalScheduleBlockTypeDb
  startsAt            DateTime
  slotDurationMinutes Int
  slotCount           Int                          @default(1)
  notes               String                       @default("")
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  doctor              MedicalPortalUser            @relation(fields: [doctorUserId], references: [id], onDelete: Cascade)
  appointments        MedicalScheduleAppointment[]

  @@index([doctorUserId, startsAt])
}

model MedicalScheduleAppointment {
  id                     String               @id @default(cuid())
  blockId                String
  patientUserId          String
  patientFirstName       String
  patientPaternalSurname String               @default("")
  patientMaternalSurname String               @default("")
  patientRut             String
  patientEmail           String               @default("")
  patientPhone           String               @default("")
  notes                  String               @default("")
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  block                  MedicalScheduleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  patient                User                 @relation(fields: [patientUserId], references: [id], onDelete: Restrict)

  @@unique([blockId, patientUserId])
  @@index([patientUserId, createdAt])
}

model MedicalPrescription {
  id                     String                      @id @default(cuid())
  prescriberUserId       String
  patientUserId          String
  patientFirstName       String
  patientPaternalSurname String                      @default("")
  patientMaternalSurname String                      @default("")
  patientRut             String
  patientBirthDate       String                      @default("")
  patientEmail           String
  patientPhone           String                      @default("")
  patientAddress         String                      @default("")
  prescriberName         String
  prescriberRut          String
  prescriberSis          String
  prescriberEmail        String
  prescriberSpecialty    String                      @default("")
  items                  Json
  verificationCode       String                      @unique
  status                 MedicalPrescriptionStatusDb @default(signed)
  fileName               String
  blobUrl                String
  blobPath               String
  sizeBytes              Int
  signedAt               DateTime                    @default(now())
  emailSentAt            DateTime?
  emailMessageId         String?
  emailError             String?
  revokedAt              DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  prescriber             MedicalPortalUser           @relation(fields: [prescriberUserId], references: [id], onDelete: Restrict)
  patient                User                        @relation(fields: [patientUserId], references: [id], onDelete: Restrict)

  @@index([prescriberUserId, createdAt])
  @@index([patientUserId, createdAt])
  @@index([patientRut, createdAt])
  @@index([status, createdAt])
}

model MedicalPortalInvitation {
  id              String              @id @default(cuid())
  email           String
  role            MedicalPortalRoleDb
  tokenHash       String              @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  invitedBy       MedicalPortalUser   @relation("MedicalPortalInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([email, createdAt])
  @@index([expiresAt, acceptedAt, revokedAt])
  @@index([invitedByUserId, createdAt])
}

model MedicalPortalSession {
  id         String            @id @default(cuid())
  tokenHash  String            @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime          @default(now())
  lastSeenAt DateTime          @default(now())
  ipHash     String?
  userAgent  String?
  user       MedicalPortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model MedicalAuditLog {
  id          String                 @id @default(cuid())
  userId      String?
  actorEmail  String
  action      String
  requestType ClinicalRequestTypeDb?
  requestId   String?
  metadata    Json?
  ipHash      String?
  createdAt   DateTime               @default(now())
  user        MedicalPortalUser?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([requestType, requestId, createdAt])
  @@index([action, createdAt])
}

model EventOutbox {
  id            String         @id @default(cuid())
  type          String
  aggregateType String
  aggregateId   String
  dedupeKey     String         @unique
  payload       Json
  status        OutboxStatusDb @default(pending)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  lockedAt      DateTime?
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
}

enum BlogPostStatusDb {
  draft
  published
}

model BlogPost {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  summary        String
  category       String
  coverImage     String
  content        String
  authorName     String
  seoTitle       String           @default("")
  seoDescription String           @default("")
  keywords       Json             @default("[]")
  status         BlogPostStatusDb @default(draft)
  publishedAt    DateTime?
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, publishedAt])
}
